{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiriaGo",
  "version": "1.1.6",
  "identifier": "app.miriago.desktop",
  "build": {
    "beforeDevCommand": "flutter build web --debug",
    "beforeBuildCommand": "flutter build web --release",
    "frontendDist": "../build/web",
    "devUrl": "http://127.0.0.1:8791"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "MiriaGo",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["sjhplan"],
        "mimeType": "application/x-miriago-sjhplan",
        "name": "MiriaGo plan package",
        "description": "MiriaGo plan package for import preview",
        "role": "Editor"
      }
    ],
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Plan and record anime pilgrimage trips.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["xdg-desktop-portal-gtk", "xdg-utils"],
        "desktopTemplate": "../packaging/linux/tauri.desktop.in"
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/tauri.desktop.in"
      }
    }
  }
}
